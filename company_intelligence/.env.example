# LLM API configuration
# Provider can be 'gemini', 'openai', or 'ollama' (for local free model running via Ollama)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
# If using 'ollama', set LLM_PROVIDER=ollama and LLM_MODEL=llama3 (or llama3.1, mistral, gemma, etc.)
# If using 'ollama', LLM_API_KEY can be left blank (it will use a dummy key automatically).
LLM_API_KEY=
# Optional: Set custom API base URL (e.g., http://localhost:11434/v1 for Ollama)
LLM_BASE_URL=

# Search API Key for enrichment (Serper API)
# If empty, the system will fall back to DuckDuckGo search queries.
SERPER_API_KEY=
